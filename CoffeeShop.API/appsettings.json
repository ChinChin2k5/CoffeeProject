{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "[YOUR_JWT_SECRET_KEY_MIN_32_CHARS_HERE]",
  "Issuer": "MyCafeServer",
  "Audience": "MyCafeClient" 
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=MY_SERVER_IP;Database=MyCafeDb;User Id=postgres;Password=[YOUR_DB_PASSWORD_HERE];TrustServerCertificate=True;"
  },
  "AdminSettings": {
    "BackdoorKey": "[YOUR_ADMIN_BACKDOOR_KEY_HERE]"
  }
}
